<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Posting to every network -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Loopback server that catches OAuth redirects on 127.0.0.1:52771 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Attaching media and exporting data through the open/save panels -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Keeping the sync folder the user picked reachable after a restart -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>