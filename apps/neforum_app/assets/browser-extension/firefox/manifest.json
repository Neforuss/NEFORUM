{
  "manifest_version": 3,
  "name": "NEFORUM",
  "short_name": "NEFORUM",
  "version": "1.1.3",
  "description": "Fills in NEFORUM hand-offs on each site (text, threads, polls, photos, videos, artwork). You post, or turn on automatic posting.",
  "homepage_url": "https://neforus.com/neforum/",
  "browser_specific_settings": {
    "gecko": {
      "id": "neforum-extension@neforus.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "NEFORUM",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "scripts": ["background.js"] },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*", "https://twitter.com/*", "https://bsky.app/*",
        "https://www.threads.com/*", "https://www.threads.net/*", "https://threads.com/*", "https://threads.net/*",
        "https://www.linkedin.com/*", "https://www.facebook.com/*", "https://m.facebook.com/*",
        "https://www.youtube.com/*", "https://studio.youtube.com/*", "https://substack.com/*", "https://www.tiktok.com/*", "https://www.instagram.com/*",
        "https://*.pinterest.com/*", "https://www.reddit.com/*", "https://www.tumblr.com/*",
        "https://web.whatsapp.com/*", "https://business.google.com/*", "https://www.snapchat.com/*",
        "https://www.behance.net/*", "https://www.artstation.com/*", "https://cara.app/*", "https://www.pixiv.net/*", "https://itaku.ee/*",
        "https://www.newgrounds.com/*", "https://www.furaffinity.net/*", "https://www.weasyl.com/*", "https://ko-fi.com/*", "https://artfol.app/*",
        "https://500px.com/*", "https://web.500px.com/*", "https://dribbble.com/*", "https://www.flickr.com/*"
      ],
      "js": ["content/fill.js", "content/recipes.js", "content/panel.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
